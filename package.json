{
  "name": "dsh-extension-manager",
  "version": "0.3.0",
  "description": "Extension Manager (鎵╁睍绠＄悊) for DeepSeek Harness (DSH): manage skills, MCP servers and plugins from the DSH Web settings page 鈥?no import, no market, stability first. Fork-lineage of dsh-extension-hub (MIT) rewritten around a safety-first composition-write pipeline.",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skill",
    "mcp",
    "plugin",
    "extension",
    "cordis"
  ],
  "license": "MIT",
  "author": "local"
}
